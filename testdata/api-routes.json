{
  "$schema": "./api-routes.schema.json",
  "license": {
    "token": "***REMOVED-LICENCE-TOKEN***",
    "publicKey": "***REMOVED-LICENCE-KEY***",
    "url": "https://cladone.com/"
  },
  "authProvider": {
    "type": "oidc",
    "issuer": "https://auth.cladone.com/realms/cladone",
    "clientId": "cladone-login",
    "clientSecretEnv": "KEYCLOAK_CLIENT_SECRET",
    "scopes": ["openid", "profile", "email", "offline_access"],
    "loginBaseUrl": "https://login.cladone.com",
    "cookieDomain": "cladone.com",
    "sessionStore": {
      "type": "bolt",
      "path": "/data/gate-one-state.db"
    },
    "sessionTtlSeconds": 3600,
    "backchannelLogout": true,
    "legacyTokenCookies": true,
    "mcpAudience": "auto"
  },
  "securityHeaders": {
    "hstsMaxAge": 15552000,
    "nosniff": true,
    "referrerPolicy": "strict-origin-when-cross-origin"
  },
  "tokenBroker": {
    "url": "http://token-broker:4000",
    "secretEnv": "TOKEN_BROKER_SHARED_SECRET"
  },
  "mcpSets": {
    "grammar": {
      "host": "mcp.cladone.com",
      "endpoint": "/grammar",
      "resource": "https://mcp.cladone.com/grammar",
      "scope": "mcp-tools",
      "members": [
        {
          "service": "grammar",
          "path": "/"
        }
      ]
    },
    "git-services-read": {
      "host": "mcp.cladone.com",
      "endpoint": "/git-services-read",
      "resource": "https://mcp.cladone.com/git-services-read",
      "scope": "mcp-tools",
      "members": [
        {
          "service": "github",
          "path": "/github",
          "tools": [
            "list_repos",
            "get_repo"
          ]
        },
        {
          "service": "github",
          "path": "/issues",
          "tools": [
            "list_issues"
          ]
        },
        {
          "service": "gitlab",
          "path": "/gitlab",
          "tools": [
            "list_projects",
            "get_project",
            "list_issues"
          ],
          "enabled": false
        }
      ]
    }
  },
  "routes": [
    {
      "host": "gram.cladone.com",
      "path": "/mcp",
      "backend": "http://grammar:8000",
      "auth": {},
      "mcp": {
        "enabled": true,
        "path": "/mcp",
        "scope": "mcp-tools",
        "operations": [
          {
            "name": "processStream",
            "operationId": "process_api_process_stream_post"
          }
        ]
      }
    },
    {
      "host": "gram.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://grammar:8000",
      "openapi": {
        "url": "http://grammar:8000/openapi.json",
        "public": false
      }
    },
    {
      "host": "mcp.cladone.com",
      "path": "/grammar/*",
      "backend": "http://grammar:8000",
      "openapi": {
        "url": "http://grammar:8000/openapi.json",
        "public": false
      },
      "mcp": {
        "enabled": true,
        "scope": "mcp-tools",
        "operations": [
          {
            "name": "processStream",
            "operationId": "process_api_process_stream_post"
          }
        ],
        "name": "grammar",
        "standalone": false
      }
    },
    {
      "host": "vers.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://versifier:9292",
      "autoHead": true,
      "userBadge": {
        "position": "right",
        "claims": [
          "preferred_username",
          "email",
          "email_verified"
        ],
        "logoutLabel": "Déconnexion"
      },
      "uiGate": [
        {
          "selector": ".liaison-options",
          "roles": [
            "offline_access"
          ]
        }
      ],
      "authGuard": {
        "forbidden": {
          "banner": true
        }
      },
      "csp": {
        "mode": "nonce",
        "reportOnly": true,
        "directives": {
          "default-src": "'self'",
          "script-src": "'self'",
          "img-src": [
            "'self'",
            "data:"
          ],
          "connect-src": [
            "'self'",
            "https://auth.cladone.com"
          ],
          "worker-src": "'self'",
          "frame-ancestors": "'none'",
          "object-src": "'none'",
          "base-uri": "'self'",
          "form-action": "'self'"
        }
      },
      "pwa": {
        "enabled": true,
        "name": "Solveur poétique",
        "themeColor": "#4285f4",
        "icons": [
          "/icon-192.png",
          "/icon-512.png"
        ],
        "apiGETCache": {
          "excludePatterns": [
            "^https://vers\\.cladone\\.com/api/poems\\?.*user=admin"
          ]
        },
        "networkOnly": {
          "excludePatterns": [
            "^https://auth\\.cladone\\.com/realms/[^/?#]+/protocol/openid-connect",
            "^https://vers\\.cladone\\.com/\\?[^#]*\\bcode="
          ]
        },
        "apiCaches": [
          {
            "path": "/api/process_stream",
            "maxEntries": 50,
            "maxAgeSeconds": 86400,
            "maxEntrySizeBytes": 2097152,
            "idleFinalizeMs": 1500
          }
        ]
      }
    },
    {
      "host": "cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://landing:80"
    },
    {
      "host": "feedback.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://feedback:3000",
      "auth": {}
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/process_stream",
      "backend": "http://versifier:9292",
      "auth": {
        "when": {
          "method": "POST",
          "body": {
            "coupes": true
          }
        },
        "identity": {
          "roles": [
            "offline_access"
          ],
          "scopes": [
            "profile"
          ],
          "claims": {
            "email": "*"
          }
        }
      },
      "quota": {
        "limit": 100,
        "period": "minute"
      },
      "rateLimit": {
        "requests": 10,
        "period": "second"
      }
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/demo/email-verified",
      "backend": "http://versifier:9292",
      "auth": {
        "when": {
          "method": "GET"
        },
        "identity": {
          "claims": {
            "email_verified": "true"
          }
        }
      }
    },
    {
      "host": "correspondances.jacquelot.cladone.com",
      "path": "/*",
      "frontend": true,
      "autoHead": true,
      "backend": "https://jacquelot.benoit-rolland.workers.dev",
      "auth": {
        "identity": {
          "roles": ["jacquelot"]
        }
      },
      "userBadge": {
        "position": "right",
        "claims": [
          "preferred_username",
          "email",
          "email_verified"
        ],
        "logoutLabel": "Déconnexion"
      },
      "upstream": {
        "host": true,
        "stripCookies": "all",
        "headers": {
          "Authorization": "Basic ${JACQUELOT_BASIC_AUTH}"
        },
        "rewriteRedirects": true,
        "rewriteBody": {
          "enabled": true,
          "except": [
            "/CorrespondancesBonPapaEtBonneMaman/"
          ]
        },
        "browserCache": {
          "imagesMaxAgeSeconds": 604800
        }
      }
    },
    {
      "host": "api.cladone.com",
      "path": "/github/*",
      "stripPrefix": "/github",
      "backend": "https://api.github.com",
      "auth": {},
      "upstream": {
        "host": true,
        "stripCookies": "all",
        "delegated": {
          "provider": "github"
        }
      }
    },
    {
      "host": "mcp.cladone.com",
      "path": "/internal-github",
      "backend": "https://api.github.com",
      "auth": {},
      "upstream": {
        "delegated": {
          "provider": "github"
        }
      },
      "openapi": {
        "url": "http://landing/github-openapi.json",
        "public": false
      },
      "mcp": {
        "enabled": true,
        "name": "github",
        "standalone": false,
        "operations": [
          {
            "name": "list_repos",
            "operationId": "list_repos"
          },
          {
            "name": "get_repo",
            "operationId": "get_repo"
          },
          {
            "name": "list_issues",
            "operationId": "list_issues"
          }
        ]
      }
    },
    {
      "host": "mcp.cladone.com",
      "path": "/internal-gitlab",
      "backend": "https://gitlab.com/api/v4",
      "auth": {},
      "upstream": {
        "delegated": {
          "provider": "gitlab"
        }
      },
      "openapi": {
        "url": "http://landing/gitlab-openapi.json",
        "public": false
      },
      "mcp": {
        "enabled": true,
        "name": "gitlab",
        "standalone": false,
        "operations": [
          {
            "name": "list_projects",
            "operationId": "list_projects"
          },
          {
            "name": "get_project",
            "operationId": "get_project"
          },
          {
            "name": "list_issues",
            "operationId": "list_issues"
          }
        ]
      }
    }
  ]
}
