<script>
(function(){
  if (window.__cladoneAuthGuard) return;
  window.__cladoneAuthGuard = true;

  var LOGIN = "%[1]s";
  var AUTH_STATE = "%[2]s";
  // Route uiGate rules (config-driven UI gating, for fronts that
  // cannot be edited) — serialized from api-routes.json; an element
  // carrying a data-gtw-* attribute ignores these rules
  // (precedence: the markup wins).
  var UIGATE = %[3]s;
  // User badge (route userBadge config): tab at the top edge,
  // unfolded on hover, claims + logout.
  var USERBADGE = %[4]s;
  // Client-side rewrite (route upstream.rewriteBody): origin hosts +
  // public target + prefix exceptions, or null. Drives the
  // configured SW below and the patching of runtime calls.
  var REWRITE = %[5]s;
  // Declarative patches of the route bundle (inject.patch): attributes
  // (typically data-gtw-*) set by selector on the existing HTML —
  // for sites whose markup cannot be edited. Applied on every
  // evaluation cycle (see bottom).
  var PATCH = %[6]s;
  var LOGIN_ORIGIN = "";
  try { LOGIN_ORIGIN = new URL(LOGIN).origin; } catch (e) {}
  // Logout: same host as the login page (auth-bridge) — clears the
  // cookies AND terminates the SSO session (OIDC end_session).
  // NB: computed AFTER LOGIN_ORIGIN is initialized (the
  // "undefined/logout" bug came from a reversed declaration order).
  var LOGOUT_URL = LOGIN_ORIGIN + "/logout";

  // auth-bridge end page: notifies this page via postMessage then
  // closes the tab.
  var DONE_URL = LOGIN_ORIGIN + "/auth/popup-done?origin=" +
    encodeURIComponent(location.origin);

  // == Runtime rewrite (upstream.rewriteBody) ==
  // The three layers share the same policy (serialized in REWRITE):
  // the client SW intercepts every call after control, this patch
  // rewrites JS calls AT CALL TIME (fetch/XHR/beacon) — including
  // those REPLAYED by the guard via "orig" — and the server engine
  // rewrites the HTML. Relative URLs (already on the public host)
  // and other origins (third-party CDNs…) are left untouched.
  function installRewrite() {
    var ORIGINS = {};
    for (var oi = 0; oi < REWRITE.origins.length; oi++) {
      ORIGINS[REWRITE.origins[oi]] = true;
    }
    var EXCEPT = REWRITE.except || [];
    var OUR_SW = REWRITE.sw || '/__gateway_pwa/sw.js';
    var rwAbort = false; // third-party SW detected: cancels diagnostic/claim

    function rewriteString(u) {
      if (typeof u !== 'string') return u;
      var m = /^(https?:\/\/|\/\/)([^\/?#]*)/.exec(u);
      if (!m) return u;
      var hp = m[2];
      if (!hp) return u;
      // the declared "host" is a hostname without port: a :port in
      // the URL is part of the rewritten prefix and is dropped from
      // the result.
      var sep = hp.indexOf(':');
      var host = sep === -1 ? hp : hp.slice(0, sep);
      if (!host || !ORIGINS.hasOwnProperty(host.toLowerCase())) return u;
      var pathStart = m[0].length;
      if (sep !== -1) {
        var port = hp.slice(sep + 1);
        if (!/^[0-9]+$/.test(port)) return u; // ':' not a port
        pathStart += port.length + 1;
      }
      var rest = u.slice(pathStart);
      for (var i = 0; i < EXCEPT.length; i++) {
        var e = EXCEPT[i];
        if (e.path && rest.indexOf(e.path) === 0) {
          if (e.to) return e.to + rest; // alternative public host
          return u;                     // exception: stays at origin
        }
      }
      return location.origin + rest;    // standard rewrite: ITS own
                                        // origin (real scheme — http
                                        // in demo, https in prod)
    }

    // fetch: rewritten at call time — no loss window, even without
    // the SW. Request, string and URL all handled.
    var of = window.fetch;
    if (of) {
      window.fetch = function (input, init) {
        try {
          if (input instanceof Request) {
            var r = rewriteString(input.url);
            if (r !== input.url) {
              // method/headers/body/mode preserved
              input = new Request(r, input);
            }
          } else if (typeof input === 'string' || input instanceof URL) {
            var s = rewriteString(String(input));
            if (s !== String(input)) input = s;
          }
        } catch (e) { /* not rewritable: normal call */ }
        return of.call(this, input, init);
      };
    }

    // XHR: the URL passed to open() is rewritten, everything else
    // goes through (direct mutation of arguments, without changing
    // variability).
    var oOpen = XMLHttpRequest.prototype.open;
    if (oOpen) {
      XMLHttpRequest.prototype.open = function () {
        try {
          if (typeof arguments[1] === 'string') {
            var s = rewriteString(arguments[1]);
            if (s !== arguments[1]) arguments[1] = s;
          }
        } catch (e) { /* normal routing */ }
        return oOpen.apply(this, arguments);
      };
    }

    // sendBeacon (site telemetry/diagnostics): same.
    var oBeacon = navigator.sendBeacon;
    if (oBeacon) {
      navigator.sendBeacon = function (url, data) {
        try {
          var s = rewriteString(String(url));
          if (s !== String(url)) url = s;
        } catch (e) { /* normal routing */ }
        return oBeacon.call(navigator, url, data);
      };
    }

    // EventSource and WebSocket stay unwrapped (constructors awkward
    // to extend cleanly: instanceof…), and are covered by the SW
    // after the claim, and by the catch-up reload below for early
    // escapes.

    // == Unified client SW: registration ==
    var swAllowed = location.protocol === 'https:' ||
      location.hostname === 'localhost' ||
      location.hostname === '127.0.0.1' ||
      location.hostname.endsWith('.localhost');
    if ('serviceWorker' in navigator && swAllowed) {
      try {
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          for (var i = 0; i < regs.length; i++) {
            var act = regs[i].active || regs[i].waiting || regs[i].installing;
            if (act && act.scriptURL.indexOf(OUR_SW) === -1) {
              // Third-party SW (the one the proxied site itself
              // registers under our origin): we do not overwrite —
              // the site knows its own logic. The fetch/XHR patch
              // above stays active; no heal below.
              rwAbort = true;
              console.warn('[gateway] third-party service worker detected (' +
                act.scriptURL + '): registration cancelled, post-load interception unavailable');
              return null;
            }
          }
          return navigator.serviceWorker.register(OUR_SW, { scope: '/' });
        }).then(function (reg) {
          if (reg) {
            console.info('[gateway] rewrite SW ' +
              (reg.active ? 'active' : 'installed, waiting for control'));
          }
        }, function (err) {
          console.warn('[gateway] service worker registration failed: ' + err);
        });
      } catch (e) { /* diagnostics only, never breaks the page */ }
    }

    // == Diagnostic: the "went to the origin" window ==
    // fetch/XHR/beacon are rewritten above, yet a load started
    // BEFORE SW control was not intercepted (and dynamic import()
    // cannot be intercepted at all). Snapshot via
    // PerformanceObserver(buffered:true) + controllerchange: origin
    // resource (outside exceptions) started before claim => ONE
    // catch-up reload per session (sessionStorage marker — no
    // loop).
    var tClaim = (navigator.serviceWorker &&
      navigator.serviceWorker.controller) ? 0 : Infinity;
    if (navigator.serviceWorker) {
      navigator.serviceWorker.addEventListener('controllerchange', function () {
        tClaim = performance.now();
      });
    }
    var rwEscape = false;
    function isRwExitPath(p) {
      for (var i = 0; i < EXCEPT.length; i++) {
        if (EXCEPT[i].path && p.indexOf(EXCEPT[i].path) === 0) return true;
      }
      return false;
    }
    function rwHeal() {
      if (rwAbort || rwEscape) return;
      rwEscape = true;
      try {
        if (sessionStorage.getItem('gw-rw-heal')) return; // already tried
        sessionStorage.setItem('gw-rw-heal', String(Date.now()));
      } catch (e) {
        return; // no storage: no catch-up (no loop)
      }
      console.warn('[gateway] call(s) went to the origin before SW control — catch-up reload (unique per session)');
      location.reload();
    }
    try {
      new PerformanceObserver(function (list) {
        if (rwAbort || rwEscape) return;
        var entries = list.getEntries();
        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          // JS call initiators; img/image excluded (loads from the
          // preload scanner between the HTML and this script —
          // ordinary cross-origin without CORS, never rewritten here)
          if (e.initiatorType !== 'script' &&
              e.initiatorType !== 'xmlhttprequest' &&
              e.initiatorType !== 'fetch') continue;
          var u;
          try { u = new URL(e.name); } catch (er) { continue; }
          if (!ORIGINS[u.hostname]) continue;
          if (isRwExitPath(u.pathname)) continue; // intended exception
          if (tClaim !== Infinity && e.startTime >= tClaim) continue;
          rwHeal(); // resource went to the origin before control
          if (rwEscape) return;
        }
      }).observe({ type: 'resource', buffered: true });
    } catch (e) { /* no PerformanceObserver: no diagnostics */ }
  }

  // Rewrite layer: installed BEFORE the guard wrapper — "orig" below
  // captures the patched fetch, so requests REPLAYED by the guard
  // also go through the rewrite.
  if (REWRITE) installRewrite();

  var orig = window.fetch;
  if (!orig) return;

  // Requests waiting for replay after login. Each entry carries a
  // Request cloned BEFORE the initial call (a body is single-read)
  // plus the resolve/reject of the promise handed to the app.
  var queue = [];
  var loginTab = null;
  var banner = null;
  var shownBy = null; // the click that triggered the display: must
                      // not be reclassified as an "outside click"
                      // by the dismiss handler (same dispatch)
  var watching = false;

  function buildReplay(input, init) {
    try {
      if (input instanceof Request) return input.clone();
      return new Request(input, init);
    } catch (e) {
      return null; // non-replayable body (stream, ...)
    }
  }

  function fullRedirect() {
    hideBanner();
    location.href = LOGIN + "?returnTo=" +
      encodeURIComponent(location.href);
  }

  function tabUrl() {
    return LOGIN + "?returnTo=" + encodeURIComponent(DONE_URL);
  }

  function tryOpenTab() {
    try {
      // No features argument: opens a regular tab, which renders
      // better than a popup inside installed PWAs.
      var w = window.open(tabUrl(), "cladone_login");
      if (w) { try { w.focus(); } catch (e) {} }
      return w;
    } catch (e) {
      return null;
    }
  }

  function showBanner(ev) {
    if (banner || !document.body) return;
    shownBy = ev || null;
    banner = document.createElement("div");
    banner.style.cssText =
      "position:fixed;left:0;right:0;bottom:20px;margin:0 auto;" +
      "width:fit-content;z-index:2147483647;display:flex;gap:12px;" +
      "align-items:center;background:#20242e;color:#fff;" +
      "padding:10px 14px;border-radius:10px;" +
      "box-shadow:0 8px 30px rgba(0,0,0,0.35);" +
      "font:14px/1.4 system-ui,sans-serif";
    var msg = document.createElement("span");
    msg.textContent = "Sign-in required to continue.";
    var btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Sign in";
    btn.style.cssText =
      "border:0;border-radius:6px;padding:6px 14px;cursor:pointer;" +
      "font:inherit;color:#fff;background:#4a7c59";
    btn.onclick = function () {
      hideBanner();
      ensureLogin(); // user gesture: the tab opens reliably
    };
    banner.appendChild(msg);
    banner.appendChild(btn);
    var no = document.createElement("button");
    no.type = "button";
    no.title = "Close";
    no.textContent = "\u00d7";
    no.style.cssText =
      "border:0;background:transparent;color:#aab;cursor:pointer;" +
      "font:20px/1 system-ui,sans-serif;padding:0 2px";
    no.onclick = dismiss;
    banner.appendChild(no);
    document.body.appendChild(banner);
  }

  function hideBanner() {
    if (banner) { banner.remove(); banner = null; }
  }

  // Abandon (×, click outside the banner, Escape): pending requests
  // receive their original 401 response (the application continues
  // anonymously, retryable later), login() promises resolve false,
  // and the linked login tab — if open — closes at the same time.
  // Being stuck behind an undismissable banner is a UX dead end.
  function dismiss() {
    hideBanner();
    if (loginTab && !loginTab.closed) loginTab.close();
    loginTab = null;
    var pending = queue.splice(0, queue.length);
    pending.forEach(function (entry) {
      if (entry.barrier) { entry.resolve(false); return; }
      entry.resolve(entry.res401);
    });
  }

  function ensureLogin() {
    if (LOGIN_ORIGIN === "") { fullRedirect(); return; }
    if (loginTab && !loginTab.closed) {
      try { loginTab.focus(); } catch (e) {}
      return;
    }
    hideBanner();
    loginTab = tryOpenTab();
    if (!loginTab) showBanner(); // blocker: banner click will open it
    watchTab();
  }

  // Tab closed without success (user, blocker) — Option C:
  //   - explicit login() promises resolve false silently: the user
  //     just said "not now", no point insisting again;
  //   - only the requests actually frozen keep the banner — their
  //     only exit surface (Sign in or ×); without it the application
  //     would stay frozen without explanation.
  function watchTab() {
    if (watching) return;
    watching = true;
    var iv = setInterval(function () {
      if (loginTab && !loginTab.closed) return;
      clearInterval(iv);
      watching = false;
      loginTab = null;
      var kept = [];
      queue.forEach(function (entry) {
        if (entry.barrier) { entry.resolve(false); return; }
        kept.push(entry);
      });
      queue = kept;
      if (queue.length > 0) showBanner();
    }, 400);
  }

  function flushQueue() {
    var pending = queue.splice(0, queue.length);
    pending.forEach(function (entry) {
      if (entry.barrier) { entry.resolve(true); return; }
      orig(entry.req).then(entry.resolve, entry.reject);
    });
  }

  window.addEventListener("message", function (ev) {
    if (ev.origin !== LOGIN_ORIGIN) return;
    if (ev.data !== "cladone-auth:ok") return;
    if (loginTab && !loginTab.closed) loginTab.close();
    loginTab = null;
    hideBanner();
    if (sessionDied) {
      // re-sign-in after a session death: reload to restore the
      // content (lazy images died with the session); the browser
      // restores the scroll position on reload.
      sessionDied = false;
      location.reload();
      return;
    }
    settleState(true);
    fetchSession(); // post-login roles/scopes/claims (re-probe)
    flushQueue();
  });

  // == Declarative gating: [data-gtw-auth] + [data-gtw-auth-hidden] ==
  //   Two orthogonal dimensions (see the click handler below for the
  //   behavior matrix). Zero app code: applications DECLARE, the
  //   gateway toggles. Applications using no attribute are fully
  //   transparent: authentication happens mid-flow through the fetch
  //   wrapper above, nothing is hidden.
  var authed = false;
  var probeDone = false;
  var stateWaiters = [];
  var sessionRoles = [];
  var sessionScopes = [];
  var sessionClaims = {};
  // the session died MID-READ (SSO idle, revocation): content already
  // displayed (lazy images…) must be restored after re-sign-in — a
  // reload does it (the browser also restores the scroll position
  // then).
  var sessionDied = false;

  function settleState(v, force) {
    // A session acquired (successful login, popup-done message) must
    // not be downgraded by a probe response arriving late or being
    // transient (network, 5xx): state never goes down from true to
    // false. ONLY exception: an AUTHORITATIVE 401 from the probe
    // (force) — the session really died mid-flight: the veil closes,
    // the badge disappears, the banner offers signing in again.
    if (authed && !v && !force) return;
    if (authed && !v && force) sessionDied = true;
    probeDone = true;
    authed = v;
    if (v) {
      document.documentElement.classList.add("cladone-authed");
      try { buildBadge(); } catch (e) { /* the badge never breaks anything */ }
    } else {
      document.documentElement.classList.remove("cladone-authed");
      if (USERBADGE &&
          (sessionDied || USERBADGE.loginBadge)) {
        // the handle becomes the sign-in invitation (detected session
        // death, or loginBadge option: from anonymous on)
        try { buildLoginBadge(); }
        catch (e) { if (badgeEl) { badgeEl.remove(); badgeEl = null; } }
      } else if (badgeEl) {
        badgeEl.parentNode.removeChild(badgeEl);
        badgeEl = null;
      }
    }
    var waiters = stateWaiters.splice(0, stateWaiters.length);
    waiters.forEach(function (r) { r(v); });
  }

  try {
    var cssText =
      "html:not(.cladone-authed) [data-gtw-auth-hidden='before']" +
      "{display:none !important}" +
      "html.cladone-authed [data-gtw-auth-hidden='after']" +
      "{display:none !important}" +
      // identity-conditioned elements (roles/scopes/claims):
      // hidden by default (anti-FOUC), revealed after JS evaluation
      "html:not(.cladone-evaluated) [data-gtw-roles]," +
      "html:not(.cladone-evaluated) [data-gtw-scopes]," +
      "html:not(.cladone-evaluated) [data-gtw-claims]" +
      "{display:none !important}" +
      "html:not(.cladone-authed) [data-gtw-auth]{cursor:pointer}" +
      // user badge, three states: FOLDED (handle 👤+name, INVISIBLE
      // until the mouse approaches the top edge — mousemove
      // detection, pointer-events:none at rest so page clicks are
      // never blocked) / PREVIEW on hover-focus and at the
      // post-login manifestation (partial max-height: the identity
      // appears) / UNFOLDED on click (everything: claims + logout) —
      // the open rule is declared LAST: at equal specificity, it
      // wins when hover and open coexist
      ".cladone-userbadge{opacity:0;pointer-events:none}" +
      ".cladone-userbadge-near,.cladone-userbadge-reveal" +
      "{opacity:1;pointer-events:auto}" +
      ".cladone-userbadge:focus-within{opacity:1;pointer-events:auto}" +
      ".cladone-userbadge:hover,.cladone-userbadge:focus-within," +
      ".cladone-userbadge-reveal{max-height:4.6em !important}" +
      // the open state must beat :hover (otherwise the preview, more
      // specific, overrides the unfolding as soon as the mouse comes
      // back over it — the button becomes unclickable): doubled
      // class = higher specificity + declared after
      ".cladone-userbadge.cladone-userbadge-open" +
      "{max-height:24em !important;opacity:1;pointer-events:auto}";
    // anti-FOUC veil for uiGate rules: one CSS rule PER selector (an
    // invalid selector must kill only its own hiding, not the
    // others')
    for (var gi = 0; gi < UIGATE.length; gi++) {
      cssText += "html:not(.cladone-evaluated) " +
        UIGATE[gi].selector + "{display:none !important}";
    }
    var css = document.createElement("style");
    css.textContent = cssText;
    (document.head || document.documentElement).appendChild(css);
  } catch (e) { /* never break the page over gating */ }

  // Gating by roles/scopes/claims: an element is visible only if ALL
  // its identity conditions pass (OR within an attribute, AND across
  // attributes). Anonymous = no role/scope/claim → hidden
  // (authentication is implicit). UI comfort only: the real
  // enforcement stays endpoint-side (auth.when.roles/scopes/claims)
  // or backend.
  // Patches (bundle inject.patch): set the attributes on matched
  // elements — idempotent, applied on every evaluation (dynamically
  // added elements are covered at the next cycle).
  // An invalid selector is ignored (like uiGate): never a visible
  // exception.
  function applyPatches() {
    for (var i = 0; i < PATCH.length; i++) {
      var rule = PATCH[i];
      if (!rule || !rule.selector || !rule.attrs) continue;
      var nodes;
      try {
        nodes = document.querySelectorAll(rule.selector);
      } catch (e) { continue; }
      for (var j = 0; j < nodes.length; j++) {
        for (var k in rule.attrs) {
          nodes[j].setAttribute(k, rule.attrs[k]);
        }
      }
    }
  }

  function applyRoleGating() {
    applyPatches();
    var nodes = document.querySelectorAll(
      "[data-gtw-roles],[data-gtw-scopes],[data-gtw-claims]"
    );
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      var ok = true;
      var rl = n.getAttribute("data-gtw-roles");
      if (ok && rl) {
        ok = rl.split(/\s+/).filter(Boolean).some(function (r) {
          return sessionRoles.indexOf(r) !== -1;
        });
      }
      if (ok) {
        var sc = n.getAttribute("data-gtw-scopes");
        if (sc) {
          ok = sc.split(/\s+/).filter(Boolean).some(function (s) {
            return sessionScopes.indexOf(s) !== -1;
          });
        }
      }
      if (ok) {
        var cl = n.getAttribute("data-gtw-claims");
        if (cl) {
          try {
            var spec = JSON.parse(cl);
            for (var k in spec) {
              var want = spec[k];
              var have = sessionClaims[k];
              if (want === "*") {
                if (have === undefined) { ok = false; break; }
              } else if (String(have) !== want) {
                ok = false; break;
              }
            }
          } catch (e) { ok = false; }
        }
      }
      if (!ok) {
        n.style.display = "none";
        n.setAttribute("data-gtw-gated-off", "1");
      } else if (n.getAttribute("data-gtw-gated-off")) {
        n.removeAttribute("data-gtw-gated-off");
        n.style.display = "";
      }
    }
    applyRuleGating();
    // evaluation is done: lift the anti-FOUC veil (the inline hiding
    // of non-passing elements stays in place)
    document.documentElement.classList.add("cladone-evaluated");
  }

  // User badge (userBadge config): tab folded at the top edge
  // (position left|right), unfolded on hover/focus (CSS, transitioned
  // max-height). Content: the chosen claims + the logout button
  // (end_session navigation). Absent when anonymous and without
  // policy. Built in pure DOM (never innerHTML).
  var badgeEl = null;

  function removeBadge() {
    if (badgeEl) {
      badgeEl.parentNode.removeChild(badgeEl);
      badgeEl = null;
    }
  }

  // Common base for both badge modes (authenticated / login
  // invitation): typography adaptive to the host site + base styles.
  function makeBadgeEl() {
    var pos = USERBADGE.position === "left" ? "left" : "right";
    // adaptive typography: follow the host site — median of the
    // computed font sizes of text elements (fallback: body, then
    // 13px), bounded 11-15px; ALL badge dimensions are in em and
    // follow. Hardcoded 13px was too big on a fine-typography site
    // (pre-paginated book) and just right on vers.
    var fs = 13;
    try {
      var sizes = [];
      var sample = document.querySelectorAll(
        "p,li,td,th,blockquote,dd,figcaption"
      );
      for (var si = 0;
           si < sample.length && sizes.length < 50;
           si++) {
        var sfs = parseFloat(
          getComputedStyle(sample[si]).fontSize
        );
        if (isFinite(sfs) && sfs > 0) sizes.push(sfs);
      }
      var siteFs;
      if (sizes.length) {
        sizes.sort(function (a, b) { return a - b; });
        siteFs = sizes[Math.floor(sizes.length / 2)];
      } else {
        siteFs = parseFloat(
          getComputedStyle(document.body).fontSize
        );
      }
      if (isFinite(siteFs) && siteFs > 0) {
        fs = Math.min(Math.max(siteFs * 0.9, 11), 15);
      }
    } catch (e) { /* measurement impossible: default 13px */ }
    fs = Math.round(fs * 10) / 10;
    badgeEl = document.createElement("div");
    badgeEl.className = "cladone-userbadge";
    // stuck to the TOP edge, 12 px side offset, rounded corners at
    // the bottom only (it touches the top)
    badgeEl.style.cssText =
      "position:fixed;top:0;" + pos + ":12px;z-index:2147483646;" +
      "background:#20242e;color:#fff;padding:.46em .92em;" +
      "font:" + fs + "px/1.4 system-ui,sans-serif;" +
      "text-align:left;" +
      "border-radius:0 0 .62em .62em;max-width:21.5em;" +
      "box-shadow:0 4px 18px rgba(0,0,0,.3);" +
      "max-height:2.3em;overflow:hidden;" +
      "transition:opacity .2s ease,max-height .25s ease;cursor:default";
    var tab = document.createElement("div");
    tab.className = "cladone-userbadge-tab";
    badgeEl.appendChild(tab);
    var body = document.createElement("div");
    body.className = "cladone-userbadge-body";
    body.style.cssText = "padding:.46em 0 .15em 0";
    badgeEl.appendChild(body);
    document.body.appendChild(badgeEl);
  }

  // badgeItems: a userBadge display switch (claims / roles /
  // scopes) → the items to display. true = everything the session
  // carries; false = none; a list = only the listed ones actually
  // held (list order kept, absent ones omitted).
  function badgeItems(cfg, held) {
    if (cfg === true) return held;
    if (!cfg || !cfg.length) return [];
    var out = [];
    for (var i = 0; i < cfg.length; i++) {
      if (held.indexOf(cfg[i]) !== -1) out.push(cfg[i]);
    }
    return out;
  }

  // chipsRow: one badge row — a label followed by one chip per item
  // (the session's roles / scopes). Pure DOM, like the rest of the
  // badge; ellipsis on overflow, same as the claim rows.
  function chipsRow(label, items) {
    var row = document.createElement("div");
    row.style.cssText =
      "margin-top:.38em;white-space:nowrap;overflow:hidden;" +
      "text-overflow:ellipsis";
    row.appendChild(document.createTextNode(label + ":"));
    for (var i = 0; i < items.length; i++) {
      var chip = document.createElement("span");
      chip.textContent = String(items[i]);
      chip.style.cssText =
        "display:inline-block;margin:0 .15em -.1em .38em;padding:" +
        ".08em .5em;border-radius:.8em;background:rgba(255,255,255,.16);" +
        "font-size:.86em";
      row.appendChild(chip);
    }
    return row;
  }

  function buildBadge() {
    if (!USERBADGE || !authed || !document.body) return;
    if (badgeEl &&
        badgeEl.getAttribute("data-gtw-mode") === "login") {
      removeBadge(); // the mode changed: rebuild as authenticated
    }
    if (!badgeEl) {
      makeBadgeEl();
      badgeEl.setAttribute("data-gtw-mode", "authed");
      // discreet post-login manifestation: unfolded 2 s then hidden
      badgeEl.classList.add("cladone-userbadge-reveal");
      setTimeout(function () {
        if (badgeEl) badgeEl.classList.remove("cladone-userbadge-reveal");
      }, 2000);
    }
    // first line (visible even folded): the icon + the identity
    var tab = badgeEl.firstChild;
    tab.textContent = "\uD83D\uDC64 " + String(sessionClaims.preferred_username || "account");
    var body = badgeEl.lastChild;
    body.textContent = "";
    // claims: true = every claim the probe returned; false = none;
    // a list = only those (missing omitted) — the historical form.
    var claimNames = badgeItems(
      USERBADGE.claims, Object.keys(sessionClaims));
    for (var i = 0; i < claimNames.length; i++) {
      if (claimNames[i] === "preferred_username") continue; // already at the top
      var v = sessionClaims[claimNames[i]];
      if (v === undefined) continue; // absent claim: line omitted
      var row = document.createElement("div");
      row.style.cssText =
        "white-space:nowrap;overflow:hidden;text-overflow:ellipsis";
      row.textContent = claimNames[i] + ": " + String(v);
      body.appendChild(row);
    }
    // roles / scopes chips (USERBADGE.roles / .scopes): the same
    // data the when.conditions and the data-gtw-roles gating see —
    // read once from the /__gateway/auth probe.
    if (sessionRoles.length) {
      var rl = badgeItems(USERBADGE.roles, sessionRoles);
      if (rl.length) body.appendChild(chipsRow("roles", rl));
    }
    if (sessionScopes.length) {
      var sc = badgeItems(USERBADGE.scopes, sessionScopes);
      if (sc.length) body.appendChild(chipsRow("scopes", sc));
    }
    var btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = USERBADGE.logoutLabel || "Log out";
    btn.style.cssText =
      "margin-top:.46em;border:0;border-radius:.46em;padding:.38em .77em;" +
      "cursor:pointer;font:inherit;color:#fff;background:#a04040";
    btn.onclick = function () {
      location.href = LOGOUT_URL + "?returnTo=" +
        encodeURIComponent(location.href);
    };
    body.appendChild(btn);
  }

  // "Login invitation" badge mode: after a session death, the same
  // handle stays in place — clicking it reopens the login (the
  // affordance persists even after the banner is dismissed).
  // Invisible until the mouse approaches the edge, as in
  // authenticated mode.
  function buildLoginBadge() {
    if (!USERBADGE || authed || !document.body) return;
    removeBadge();
    makeBadgeEl();
    badgeEl.setAttribute("data-gtw-mode", "login");
    badgeEl.style.cursor = "pointer";
    badgeEl.title = "Sign in again";
    badgeEl.firstChild.textContent =
      "\uD83D\uDC64 " + "Sign in";
    badgeEl.onclick = function (ev) {
      ev.stopPropagation();
      ensureLogin();
    };
    // discreet manifestation: visible 2 s to get noticed, then as
    // discreet as the authenticated badge
    badgeEl.classList.add("cladone-userbadge-reveal");
    setTimeout(function () {
      if (badgeEl) badgeEl.classList.remove("cladone-userbadge-reveal");
    }, 2000);
  }

  // Detection of the TOP edge approach: the badge is invisible
  // (opacity 0 + pointer-events none) until the mouse approaches
  // (clientY <= 40); it stays visible while hovered, unfolded, or
  // in its post-login manifestation.
  if (USERBADGE) {
    window.addEventListener("mousemove", function (ev) {
      if (!badgeEl) return;
      var near = badgeEl.matches(":hover") ||
        badgeEl.classList.contains("cladone-userbadge-open") ||
        badgeEl.classList.contains("cladone-userbadge-reveal");
      if (!near && ev.clientY <= 40) {
        // proximity to the badge's OWN ZONE (not the whole top
        // edge): top vertical band + horizontal radius around the
        // handle (the badge reacts only to approaching ITS corner)
        var r = badgeEl.getBoundingClientRect();
        var margin = 150;
        near = ev.clientX >= r.left - margin &&
               ev.clientX <= r.right + margin;
      }
      badgeEl.classList.toggle("cladone-userbadge-near", near);
    });
  }

  // Gating by uiGate rules (config): same mechanisms as the markup
  // attributes, but elements are designated by CSS selector. An
  // element carrying a data-gtw-* attribute is IGNORED by the rules
  // (precedence: the markup wins). Several rules on the same
  // element accumulate with AND. Invalid selector = rule ignored,
  // never a visible error.
  function rulePasses(rule) {
    var ok = true;
    if (ok && rule.roles && rule.roles.length) {
      ok = rule.roles.some(function (r) {
        return sessionRoles.indexOf(r) !== -1;
      });
    }
    if (ok && rule.scopes && rule.scopes.length) {
      ok = rule.scopes.some(function (s) {
        return sessionScopes.indexOf(s) !== -1;
      });
    }
    if (ok && rule.claims) {
      for (var k in rule.claims) {
        var want = rule.claims[k];
        var have = sessionClaims[k];
        if (want === "*") {
          if (have === undefined) { ok = false; break; }
        } else if (String(have) !== want) {
          ok = false; break;
        }
      }
    }
    return ok;
  }

  function applyRuleGating() {
    for (var i = 0; i < UIGATE.length; i++) {
      var rule = UIGATE[i];
      if (!rule || !rule.selector) continue;
      var nodes;
      try {
        nodes = document.querySelectorAll(rule.selector);
      } catch (e) {
        continue; // invalid selector: rule ignored
      }
      if (nodes.length === 0) {
        // the rule is served by the gateway but matches NO element
        // of this page: likely a typo in the selector (#id vs
        // .class…) — logged for debugging, no side effect (assumed
        // fail-open)
        console.warn(
          "uiGate: rule without element (selector):", rule.selector
        );
        continue;
      }
      for (var j = 0; j < nodes.length; j++) {
        var n = nodes[j];
        if (n.hasAttribute("data-gtw-auth") ||
            n.hasAttribute("data-gtw-auth-hidden") ||
            n.hasAttribute("data-gtw-roles") ||
            n.hasAttribute("data-gtw-scopes") ||
            n.hasAttribute("data-gtw-claims")) {
          continue; // precedence: the markup wins
        }
        var ok = rulePasses(rule);
        if (!ok) {
          n.style.display = "none";
          n.setAttribute("data-gtw-gated-off", "1");
        } else if (n.getAttribute("data-gtw-gated-off")) {
          n.removeAttribute("data-gtw-gated-off");
          n.style.display = "";
        }
      }
    }
  }

  function fetchSession() {
    orig(AUTH_STATE, { cache: "no-store" }).then(function (res) {
      if (res.status === 401) {
        // 401 = the truth of the moment (the server just checked):
        // the session expired or was revoked during the read.
        sessionRoles = [];
        sessionScopes = [];
        sessionClaims = {};
        applyRoleGating();
        settleState(false, true);
        if (sessionDied) showBanner(); // invitation to sign in again
        return;
      }
      if (res.status !== 200) {
        // 5xx/429…: transient — the displayed state does not move.
        settleState(false);
        return;
      }
      res.json().then(function (s) {
        sessionRoles = s.roles || [];
        sessionScopes = s.scopes || [];
        sessionClaims = s.claims || {};
        applyRoleGating();
        settleState(true);
      }).catch(function () {
        applyRoleGating();
        settleState(false);
      });
    }).catch(function () {
      // network/SW in error: fail-closed — no revelation of
      // identity-conditioned elements
      settleState(false);
    });
  }

  function probeSession() {
    // data-gtw-logout and userBadge ALSO require the probe: logout
    // only applies when authenticated, and the badge needs claims.
    if (!document.querySelector(
      "[data-gtw-auth],[data-gtw-auth-hidden],[data-gtw-logout]," +
      "[data-gtw-roles],[data-gtw-scopes],[data-gtw-claims]"
    ) && !UIGATE.length && !USERBADGE && !PATCH.length) {
      return; // no gating declared: no probe, fully transparent
    }
    fetchSession();
  }

  // Session probe (Bearer header or cookie session), gateway-served,
  // never cached by the PWA service worker ("auth" exclude pattern).
  // AUTH_STATE is injected from AuthStatePath (guard.go). Runs at
  // DOMContentLoaded so pages without any gated element make no
  // request at all.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", probeSession);
  } else {
    probeSession();
  }

  // Periodic re-probe + on tab return: the session can die MID-READ
  // (SSO idle, revocation) — the badge and the gating reflect the
  // real state, not a stale one. BONUS: the probe keeps the session
  // alive (silent refresh on /auth) — reading for a long time
  // without loading images no longer lets it expire.
  setInterval(probeSession, 60000);
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden) probeSession();
  });

  // Click handling while anonymous (capture phase). Two attributes,
  // two orthogonal dimensions:
  //
  //   data-gtw-auth — WHEN auth happens:
  //     "after"  : native click preserved (no preventDefault) — the
  //                auth is enforced at the request level (401 queued,
  //                replayed after login) ; the tab opens on click as
  //                an invitation ;
  //     "before" : the click is neutralized (no native request) and
  //                the login tab opens directly — authenticate
  //                first, act after.
  //
  //   data-gtw-auth-hidden — visibility:
  //     "before" : hidden while anonymous — activating clicks
  //                (direct, synthetic label activation) are
  //                neutralized: never a silent pre-tick, the banner
  //                offers "Sign in" ;
  //     "after"  : no click interception (pure affordance hiding,
  //                composable with gtw-auth="before" for padlocks).
  document.addEventListener("click", function (ev) {
    var t = ev.target;
    if (!t || !t.closest) return;

    // badge (authenticated): click inside → full unfold (toggle);
    // click outside → fold back. The logout button does not toggle:
    // it navigates (its own onclick).
    if (authed && badgeEl) {
      if (badgeEl.contains(t)) {
        if (!t.closest("button")) {
          badgeEl.classList.toggle("cladone-userbadge-open");
        }
        return;
      }
      badgeEl.classList.remove("cladone-userbadge-open");
    }

    // Logout (data-gtw-logout): the look is entirely up to the app,
    // the guard only wires the click. AUTHENTICATED only — silently
    // ignored when anonymous (nothing to log out of). The NAVIGATION
    // is inherent: OIDC end_session is a redirect; back on this
    // page, now anonymous (gating re-applied).
    if (authed && t.closest("[data-gtw-logout]")) {
      location.href = LOGOUT_URL + "?returnTo=" +
        encodeURIComponent(location.href);
      return;
    }

    if (authed) return; // authenticated: native clicks (passthrough)
    var before = t.closest('[data-gtw-auth="before"]');
    if (before) {
      ev.preventDefault();
      ev.stopPropagation();
      window.__cladoneAuth.login();
      return;
    }
    var after = t.closest('[data-gtw-auth="after"]');
    if (after) {
      // the native action proceeds (ticking the box…); the 401
      // request resulting from it is queued then replayed after login
      window.__cladoneAuth.login();
      return;
    }
    var hiddenPre = t.closest('[data-gtw-auth-hidden="before"]');
    if (hiddenPre) {
      ev.preventDefault();
      ev.stopPropagation();
      showBanner(ev);
      return;
    }

    // uiGate rules (config): pre-auth gating and hiding — same
    // semantics as the markup attributes; a markup element already
    // short-circuited above (precedence)
    for (var gi = 0; gi < UIGATE.length; gi++) {
      var rule = UIGATE[gi];
      if (!rule || !rule.selector) continue;
      var hit = null;
      try {
        hit = t.closest(rule.selector);
      } catch (e) {
        continue; // invalid selector: rule ignored (like in
                  // applyRuleGating) — never a visible exception
      }
      if (!hit) continue;
      if (rule.hidden === "before") {
        // control hidden while anonymous: any click reaching it is
        // synthetic (label activation) — never a pre-tick
        ev.preventDefault();
        ev.stopPropagation();
        showBanner(ev);
        return;
      }
      if (rule.auth) {
        if (rule.auth === "before") {
          ev.preventDefault();
          ev.stopPropagation();
        }
        // "after": the native action proceeds, the 401 will be replayed
        window.__cladoneAuth.login();
        return;
      }
    }

    var lbl = t.closest("label");
    if (lbl && lbl.querySelector('[data-gtw-auth-hidden="before"]')) {
      ev.preventDefault();
      ev.stopPropagation();
      showBanner(ev);
    }
  }, true);

  // The banner closes without any authentication action: a click
  // anywhere outside it, or Escape — and the linked login tab closes
  // with it (see dismiss). Registered AFTER the affordance handler
  // above: a click on a login element (or on a banner button)
  // always wins.
  document.addEventListener("click", function (ev) {
    if (!banner) return;
    if (banner.contains(ev.target)) return;
    if (shownBy === ev) return; // the click that displayed the banner
    dismiss();
  }, true);

  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape" && banner) dismiss();
  }, true);

  // Opt-in API for apps willing to trigger the same no-reload login
  // from their own UI, or to know the session state. login() opens
  // the tab directly (explicit user intent) and resolves true once
  // the gateway session is active, false if abandoned (×). state()
  // resolves to the current session state (probe result).
  window.__cladoneAuth = {
    login: function () {
      return new Promise(function (resolve, reject) {
        queue.push({ barrier: true, resolve: resolve, reject: reject });
        ensureLogin();
      });
    },
    state: function () {
      return new Promise(function (resolve) {
        if (probeDone) { resolve(authed); return; }
        stateWaiters.push(resolve);
      });
    },
    // Detailed session (opt-in): {roles, scopes, claims} once the
    // probe has passed (or null when anonymous). For applications
    // that want to filter in JS without re-reading a token.
    session: function () {
      return new Promise(function (resolve) {
        var snap = function (ok) {
          resolve(ok ? {
            roles: sessionRoles.slice(),
            scopes: sessionScopes.slice(),
            claims: sessionClaims
          } : null);
        };
        if (probeDone) { snap(authed); return; }
        stateWaiters.push(snap);
      });
    }
  };

  window.fetch = function (input, init) {

    // Clone BEFORE the call: a Request body can be read only once,
    // the copy is kept for the post-login replay.
    var replay = buildReplay(input, init);

    return orig.apply(this, arguments).then(function (res) {

      // 401 ONLY: it is the "authenticate yourself" signal. A 403
      // (authenticated but insufficient rights — when.roles/scopes/
      // claims) goes through to the application: offering a login on
      // a rights refusal would create a loop.
      if (!res || res.status !== 401 || res.url.startsWith(LOGIN)) {
        return res;
      }

      if (!replay || LOGIN_ORIGIN === "") {
        // Cannot replay: historical fallback, full-page redirect
        // (the app reloads and re-issues the request itself).
        setTimeout(fullRedirect, 0);
        return new Promise(function () {}); // navigation takes over
      }

      return new Promise(function (resolve, reject) {
        // mid-flow 401 (click outside a login affordance): banner
        // ONLY — never an auto-opened tab, a background 401 must not
        // steal focus. The tab only opens on an explicit click
        // (padlock, banner button). Dismissable banner (×): requests
        // leave with their original 401, the app continues.
        queue.push({ req: replay, res401: res, resolve: resolve, reject: reject });
        // an already-open login tab IS the invitation: no redundant
        // banner next to it
        if (!(loginTab && !loginTab.closed)) showBanner();
      });
    });
  };
})();
</script>
