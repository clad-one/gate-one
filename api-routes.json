{
  "routes": [    
    {
      "host": "gram.cladone.com",
      "path": "/mcp",
      "backend": "http://grammar:8000",
      "auth": {},
      "mcp": {
        "enabled": true,
        "path": "/mcp",
        "scope": "mcp-tools",
        "operations": [
          {
            "name": "processStream",
            "operationId": "process_api_process_stream_post"
          }
        ]
      }
    },
    {
      "host": "gram.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://grammar:8000",
      "openapi": {
        "url": "http://grammar:8000/openapi.json",
        "public": false
      }
    },
    {
      "host": "vers.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://versifier:9292",
      "autoHead": true,
      "pwa": {
        "enabled": true,
        "name": "Versifier",
        "themeColor": "#4285f4",
        "icons": ["/icon-192.png", "/icon-512.png"],
        "apiGETCache": {
          "excludePatterns": [
            "^https://vers\\.cladone\\.com/api/poems\\?.*user=admin"
          ]
        },
        "networkOnly": {
          "excludePatterns": [
            "/protocol/openid-connect",
            "/auth",
            "[?&]code=",
            "[?&]state=",
            "[?&]session_state=",
            "[?&]iss="
          ]
        },
        "apiCaches": [
          {
            "path": "/api/process_stream",
            "maxEntries": 50,
            "maxAgeSeconds": 86400,
            "maxEntrySizeBytes": 2097152,
            "idleFinalizeMs": 1500
          }
        ]
      }
    },
    {
      "host": "cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://landing:80"
    },
    {
      "host": "feedback.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://feedback:3000",
      "auth": {}
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/process_stream",
      "backend":"http://versifier:9292",
      "auth":{
        "when":{
          "method":"POST",
          "body":{
            "coupes":true
          },
          "roles":["offline_access"],
          "scopes":["profile"],
          "claims":{
            "email":"*"
          }
        }
      },
      "quota": {
        "limit": 100,
        "period": "minute"
      },
      "rateLimit": {
        "requests": 10,
        "period": "second"
      }
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/demo/email-verified",
      "backend":"http://versifier:9292",
      "auth":{
        "when":{
          "method":"GET",
          "claims":{
            "email_verified":"true"
          }
        }
      }
    }
  ]
}