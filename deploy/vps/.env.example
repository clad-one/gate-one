# Copy to .env and fill the blank values.
# `make init` creates this file and generates the empty secrets.

# Public base domain. Gate One is published on:
#   app.<domain>    the protected application
#   login.<domain>  the login surface
#   auth.<domain>   the embedded IAM (cladone-auth)
#   idp.<domain>    the demo IdP, only with the "demo" profile
DOMAIN=
ACME_EMAIL=

# Google OAuth client (production). Authorized redirect URI:
#   https://auth.<domain>/t/main/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo IdP client (only with the "demo" profile; any value works).
DEMO_IDP_CLIENT_ID=demo-client
DEMO_IDP_CLIENT_SECRET=demo-secret

# Shared secret between Gate One and the broker. Generated by `make init`.
GATE_ONE_OIDC_CLIENT_SECRET=

# Session signing key, identical on every replica. Generated by `make init`.
GATE_ONE_SESSION_KEY=

# Directory holding gate-one, cladone-auth and (for the demo) demo-idp.
BIN_DIR=./bin
