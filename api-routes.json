{
  "routes": [    
    {
      "host": "gram.cladone.com",
      "path": "/mcp",
      "backend": "http://grammar:8000",
      "auth": {},
      "mcp": {
        "enabled": true,
        "path": "/mcp",
        "operations": [
          {
            "name": "processStream",
            "operationId": "process_api_process_stream_post"
          }
        ]
      }
    },
    {
      "host": "gram.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://grammar:8000",
      "openapi": {
        "url": "http://grammar:8000/openapi.json",
        "public": false
      }
    },
    {
      "host": "vers.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://versifier:9292",
      "autoHead": true,
      "pwa": {
        "enabled": true,
        "name": "Versifier",
        "themeColor": "#4285f4"
      }
    },
    {
      "host": "cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://landing:80"
    },
    {
      "host": "feedback.cladone.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://feedback:3000",
      "auth": {}
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/process_stream",
      "backend":"http://versifier:9292",
      "auth":{
        "when":{
          "method":"POST",
          "body":{
            "coupes":true
          }
        }
      },
      "quota": {
        "limit": 100,
        "period": "minute"
      },
      "rateLimit": {
        "requests": 10,
        "period": "second"
      }
    }
  ]
}