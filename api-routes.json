{
  "routes": [    
    {
      "host": "gram.cladone.com",
      "path": "/*",
      "backend": "http://grammar:8000"
    },
    {
      "host": "vers.cladone.com",
      "path": "/*",
      "backend": "http://versifier:9292"
    },
    {
      "host": "feedback.cladone.com",
      "path": "/*",
      "backend": "http://feedback:3000",
      "auth": {}
    },
    {
      "host": "vers.cladone.com",
      "path": "/api/process_stream",
      "backend":"http://versifier:9292",
      "auth":{
        "when":{
          "method":"POST",
          "body":{
            "coupes":true
          }
        }
      },
      "quota": {
        "limit": 100,
        "period": "minute"
      },
      "rateLimit": {
        "requests": 10,
        "period": "second"
      }
    }
  ]
}