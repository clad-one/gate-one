<script>
(function(){
  if (window.__cladoneAuthGuard) return;
  window.__cladoneAuthGuard = true;

  var LOGIN = "%[1]s";
  var AUTH_STATE = "%[2]s";
  // Règles uiGate de la route (gating UI par config, pour les fronts
  // non modifiables) — sérialisées depuis api-routes.json ; un
  // élément portant un attribut data-gtw-* ignore ces règles
  // (précédence : le markup gagne).
  var UIGATE = %[3]s;
  // Badge utilisateur (config userBadge de la route) : onglet au bord
  // supérieur, déplié au survol, claims + déconnexion.
  var USERBADGE = %[4]s;
  // Réécriture client (upstream.rewriteBody de la route) : hosts
  // d'origine + cible publique + exceptions de préfixe, ou null.
  // Pilote ci-dessous le SW configuré et le patch des appels runtime.
  var REWRITE = %[5]s;
  var LOGIN_ORIGIN = "";
  try { LOGIN_ORIGIN = new URL(LOGIN).origin; } catch (e) {}
  // Logout : même hôte que la page de login (auth-bridge) — efface
  // les cookies ET termine la session SSO (end_session OIDC).
  // NB : calculé APRÈS l'initialisation de LOGIN_ORIGIN (le bug
  // "undefined/logout" venait d'un ordre de déclaration inversé).
  var LOGOUT_URL = LOGIN_ORIGIN + "/logout";

  // auth-bridge end page: notifies this page via postMessage then
  // closes the tab.
  var DONE_URL = LOGIN_ORIGIN + "/auth/popup-done?origin=" +
    encodeURIComponent(location.origin);

  // == Réécriture runtime (upstream.rewriteBody) ==
  // Les trois couches partagent la même politique (sérialisée dans
  // REWRITE) : le SW client intercepte tout appel post-contrôle, ce
  // patch réécrit AU MOMENT DE L'APPEL les appels JS (fetch/XHR/
  // beacon) — y compris ceux REJOUÉS par la garde via "orig" — et le
  // moteur serveur réécrit le HTML. Les URLs relatives (déjà sur le
  // host public) et les autres origines (CDN tierces…) ne sont pas
  // touchées.
  function installRewrite() {
    var ORIGINS = {};
    for (var oi = 0; oi < REWRITE.origins.length; oi++) {
      ORIGINS[REWRITE.origins[oi]] = true;
    }
    var EXCEPT = REWRITE.except || [];
    var OUR_SW = REWRITE.sw || '/__gateway_pwa/sw.js';
    var rwAbort = false; // SW tiers détecté : annule diagnostic/claim

    function rewriteString(u) {
      if (typeof u !== 'string') return u;
      var m = /^(https?:\/\/|\/\/)([^\/?#]*)/.exec(u);
      if (!m) return u;
      var hp = m[2];
      if (!hp) return u;
      // le "host" déclaré est un hostname sans port : un :port de
      // l'URL fait partie du préfixe réécrit et saute du résultat.
      var sep = hp.indexOf(':');
      var host = sep === -1 ? hp : hp.slice(0, sep);
      if (!host || !ORIGINS.hasOwnProperty(host.toLowerCase())) return u;
      var pathStart = m[0].length;
      if (sep !== -1) {
        var port = hp.slice(sep + 1);
        if (!/^[0-9]+$/.test(port)) return u; // ':' non port
        pathStart += port.length + 1;
      }
      var rest = u.slice(pathStart);
      for (var i = 0; i < EXCEPT.length; i++) {
        var e = EXCEPT[i];
        if (e.path && rest.indexOf(e.path) === 0) {
          if (e.to) return e.to + rest; // host public alternatif
          return u;                     // exception : reste à l'origine
        }
      }
      return REWRITE.target + rest;     // réécriture standard
    }

    // fetch : réécrit au moment de l'appel — pas de fenêtre de
    // perdition, même sans SW. Request, chaîne et URL gérés.
    var of = window.fetch;
    if (of) {
      window.fetch = function (input, init) {
        try {
          if (input instanceof Request) {
            var r = rewriteString(input.url);
            if (r !== input.url) {
              // méthode/entêtes/corps/mode préservés
              input = new Request(r, input);
            }
          } else if (typeof input === 'string' || input instanceof URL) {
            var s = rewriteString(String(input));
            if (s !== String(input)) input = s;
          }
        } catch (e) { /* non réinscriptible : appel normal */ }
        return of.call(this, input, init);
      };
    }

    // XHR : l'URL passée à open() est réécrite, tout le reste passe
    // (mutation directe de arguments, sans changer la variabilité).
    var oOpen = XMLHttpRequest.prototype.open;
    if (oOpen) {
      XMLHttpRequest.prototype.open = function () {
        try {
          if (typeof arguments[1] === 'string') {
            var s = rewriteString(arguments[1]);
            if (s !== arguments[1]) arguments[1] = s;
          }
        } catch (e) { /* routing normal */ }
        return oOpen.apply(this, arguments);
      };
    }

    // sendBeacon (telemetry/diagnostics du site) : idem.
    var oBeacon = navigator.sendBeacon;
    if (oBeacon) {
      navigator.sendBeacon = function (url, data) {
        try {
          var s = rewriteString(String(url));
          if (s !== String(url)) url = s;
        } catch (e) { /* routing normal */ }
        return oBeacon.call(navigator, url, data);
      };
    }

    // EventSource et WebSocket restent non-wrappés (constructeurs
    // peu praticables à l'extension propre : instanceof…), et sont
    // couverts par le SW après le claim, par le rechargement de
    // rattrapage plus bas pour les sorties précoces.

    // == SW client unifié : enregistrement ==
    if ('serviceWorker' in navigator && location.protocol === 'https:') {
      try {
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          for (var i = 0; i < regs.length; i++) {
            var act = regs[i].active || regs[i].waiting || regs[i].installing;
            if (act && act.scriptURL.indexOf(OUR_SW) === -1) {
              // SW tiers (celui que le site proxifié enregistre lui-
              // même sous notre origin) : on n'écrase pas — le site
              // connaît sa propre logique. Le patch fetch/XHR
              // ci-dessus reste actif ; pas de heal ci-dessous.
              rwAbort = true;
              console.warn('[gateway] service worker tiers détecté (' +
                act.scriptURL + ') : enregistrement annulé, interception post-charge indisponible');
              return null;
            }
          }
          return navigator.serviceWorker.register(OUR_SW, { scope: '/' });
        }).then(function (reg) {
          if (reg) {
            console.info('[gateway] SW réécriture ' +
              (reg.active ? 'actif' : 'installé, en attente de contrôle'));
          }
        }, function (err) {
          console.warn('[gateway] enregistrement service worker impossible : ' + err);
        });
      } catch (e) { /* diagnostic seulement, jamais de casse page */ }
    }

    // == Diagnostic : fenêtre « parti vers l'origine » ==
    // fetch/XHR/beacon sont réécrits ci-dessus, un chargement lancé
    // AVANT le contrôle SW n'a pourtant pas été intercepté (et
    // import() dynamique n'est pas interceptable du tout). Photo via
    // PerformanceObserver(buffered:true) + controllerchange :
    // ressource d'origine (hors exceptions) démarrée avant claim =>
    // UN SEUL rechargement de rattrapage par session (marqueur
    // sessionStorage — pas de boucle).
    var tClaim = (navigator.serviceWorker &&
      navigator.serviceWorker.controller) ? 0 : Infinity;
    if (navigator.serviceWorker) {
      navigator.serviceWorker.addEventListener('controllerchange', function () {
        tClaim = performance.now();
      });
    }
    var rwEscape = false;
    function isRwExitPath(p) {
      for (var i = 0; i < EXCEPT.length; i++) {
        if (EXCEPT[i].path && p.indexOf(EXCEPT[i].path) === 0) return true;
      }
      return false;
    }
    function rwHeal() {
      if (rwAbort || rwEscape) return;
      rwEscape = true;
      try {
        if (sessionStorage.getItem('gw-rw-heal')) return; // déjà tenté
        sessionStorage.setItem('gw-rw-heal', String(Date.now()));
      } catch (e) {
        return; // pas de stockage : pas de rattrapage (pas de boucle)
      }
      console.warn('[gateway] appel(s) partis vers l\'origine avant contrôle SW — rechargement de rattrapage (unique par session)');
      location.reload();
    }
    try {
      new PerformanceObserver(function (list) {
        if (rwAbort || rwEscape) return;
        var entries = list.getEntries();
        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          // initiators d'appels JS ; img/image écartés (chargements
          // du préload scanner entre le HTML et ce script —
          // cross-origin ordinaires sans CORS, jamais réécrits ici)
          if (e.initiatorType !== 'script' &&
              e.initiatorType !== 'xmlhttprequest' &&
              e.initiatorType !== 'fetch') continue;
          var u;
          try { u = new URL(e.name); } catch (er) { continue; }
          if (!ORIGINS[u.hostname]) continue;
          if (isRwExitPath(u.pathname)) continue; // exception voulue
          if (tClaim !== Infinity && e.startTime >= tClaim) continue;
          rwHeal(); // ressource parti vers l'origine avant contrôle
          if (rwEscape) return;
        }
      }).observe({ type: 'resource', buffered: true });
    } catch (e) { /* pas de PerformanceObserver : pas de diagnostic */ }
  }

  // Couche réécriture : installée AVANT le wrapper de garde — "orig"
  // ci-dessous capture le fetch patché, les requêtes REJOUÉES par la
  // garde passent donc aussi par la réécriture.
  if (REWRITE) installRewrite();

  var orig = window.fetch;
  if (!orig) return;

  // Requests waiting for replay after login. Each entry carries a
  // Request cloned BEFORE the initial call (a body is single-read)
  // plus the resolve/reject of the promise handed to the app.
  var queue = [];
  var loginTab = null;
  var banner = null;
  var shownBy = null; // le clic à l'origine de l'affichage : ne doit
                      // pas être requalifié en « clic extérieur »
                      // par l'handler de dismiss (même dispatch)
  var watching = false;

  function buildReplay(input, init) {
    try {
      if (input instanceof Request) return input.clone();
      return new Request(input, init);
    } catch (e) {
      return null; // non-replayable body (stream, ...)
    }
  }

  function fullRedirect() {
    hideBanner();
    location.href = LOGIN + "?returnTo=" +
      encodeURIComponent(location.href);
  }

  function tabUrl() {
    return LOGIN + "?returnTo=" + encodeURIComponent(DONE_URL);
  }

  function tryOpenTab() {
    try {
      // No features argument: opens a regular tab, which renders
      // better than a popup inside installed PWAs.
      var w = window.open(tabUrl(), "cladone_login");
      if (w) { try { w.focus(); } catch (e) {} }
      return w;
    } catch (e) {
      return null;
    }
  }

  function showBanner(ev) {
    if (banner || !document.body) return;
    shownBy = ev || null;
    banner = document.createElement("div");
    banner.style.cssText =
      "position:fixed;left:0;right:0;bottom:20px;margin:0 auto;" +
      "width:fit-content;z-index:2147483647;display:flex;gap:12px;" +
      "align-items:center;background:#20242e;color:#fff;" +
      "padding:10px 14px;border-radius:10px;" +
      "box-shadow:0 8px 30px rgba(0,0,0,0.35);" +
      "font:14px/1.4 system-ui,sans-serif";
    var msg = document.createElement("span");
    msg.textContent = "Connexion requise pour continuer.";
    var btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Se connecter";
    btn.style.cssText =
      "border:0;border-radius:6px;padding:6px 14px;cursor:pointer;" +
      "font:inherit;color:#fff;background:#4a7c59";
    btn.onclick = function () {
      hideBanner();
      ensureLogin(); // user gesture: the tab opens reliably
    };
    banner.appendChild(msg);
    banner.appendChild(btn);
    var no = document.createElement("button");
    no.type = "button";
    no.title = "Fermer";
    no.textContent = "\u00d7";
    no.style.cssText =
      "border:0;background:transparent;color:#aab;cursor:pointer;" +
      "font:20px/1 system-ui,sans-serif;padding:0 2px";
    no.onclick = dismiss;
    banner.appendChild(no);
    document.body.appendChild(banner);
  }

  function hideBanner() {
    if (banner) { banner.remove(); banner = null; }
  }

  // Abandon (×, clic hors bannière, Échap) : les requêtes en attente
  // reçoivent leur réponse 401 d'origine (l'application continue en
  // anonyme, retentable plus tard), les promesses login() résolvent
  // false, et l'onglet de login lié — s'il est ouvert — se referme en
  // même temps. Rester bloqué derrière une bannière indémissible est
  // une impasse UX.
  function dismiss() {
    hideBanner();
    if (loginTab && !loginTab.closed) loginTab.close();
    loginTab = null;
    var pending = queue.splice(0, queue.length);
    pending.forEach(function (entry) {
      if (entry.barrier) { entry.resolve(false); return; }
      entry.resolve(entry.res401);
    });
  }

  function ensureLogin() {
    if (LOGIN_ORIGIN === "") { fullRedirect(); return; }
    if (loginTab && !loginTab.closed) {
      try { loginTab.focus(); } catch (e) {}
      return;
    }
    hideBanner();
    loginTab = tryOpenTab();
    if (!loginTab) showBanner(); // blocker: banner click will open it
    watchTab();
  }

  // Onglet refermé sans succès (utilisateur, bloqueur) — Option C :
  //   - les promesses login() explicites sont résolues false en
  //     silence : l'utilisateur vient de dire « pas maintenant », pas
  //     la peine de re-insister ;
  //   - seules les requêtes réellement gelées conservent la bannière
  //     — leur unique surface de sortie (Se connecter ou ×) ; sans
  //     elle l'application resterait figée sans explication.
  function watchTab() {
    if (watching) return;
    watching = true;
    var iv = setInterval(function () {
      if (loginTab && !loginTab.closed) return;
      clearInterval(iv);
      watching = false;
      loginTab = null;
      var kept = [];
      queue.forEach(function (entry) {
        if (entry.barrier) { entry.resolve(false); return; }
        kept.push(entry);
      });
      queue = kept;
      if (queue.length > 0) showBanner();
    }, 400);
  }

  function flushQueue() {
    var pending = queue.splice(0, queue.length);
    pending.forEach(function (entry) {
      if (entry.barrier) { entry.resolve(true); return; }
      orig(entry.req).then(entry.resolve, entry.reject);
    });
  }

  window.addEventListener("message", function (ev) {
    if (ev.origin !== LOGIN_ORIGIN) return;
    if (ev.data !== "cladone-auth:ok") return;
    if (loginTab && !loginTab.closed) loginTab.close();
    loginTab = null;
    hideBanner();
    if (sessionDied) {
      // reconnexion après une mort de session : recharger pour
      // restaurer le contenu (images lazy mortes avec la session) ;
      // le navigateur restaure la position de scroll au reload.
      sessionDied = false;
      location.reload();
      return;
    }
    settleState(true);
    fetchSession(); // rôles/scopes/claims post-login (re-sonde)
    flushQueue();
  });

  // == Declarative gating: [data-gtw-auth] + [data-gtw-auth-hidden] ==
  //   Two orthogonal dimensions (see the click handler below for the
  //   behavior matrix). Zero app code: applications DECLARE, the
  //   gateway toggles. Applications using no attribute are fully
  //   transparent: authentication happens mid-flow through the fetch
  //   wrapper above, nothing is hidden.
  var authed = false;
  var probeDone = false;
  var stateWaiters = [];
  var sessionRoles = [];
  var sessionScopes = [];
  var sessionClaims = {};
  // la session est morte EN COURS de lecture (idle SSO, révocation) :
  // le contenu déjà affiché (images lazy…) doit être restauré après
  // la reconnexion — un rechargement le fait (le navigateur y
  // restaure aussi la position de scroll).
  var sessionDied = false;

  function settleState(v, force) {
    // Une session acquise (login réussi, message popup-done) ne doit
    // pas être rétrogradée par une réponse de sonde arrivant en
    // retard ou transitoire (réseau, 5xx) : l'état ne descend pas de
    // true à false. SEULE exception : un 401 AUTORITAIRE de la sonde
    // (force) — la session est réellement morte en cours de route :
    // le voile se referme, le badge disparaît, la bannière propose
    // de se reconnecter.
    if (authed && !v && !force) return;
    if (authed && !v && force) sessionDied = true;
    probeDone = true;
    authed = v;
    if (v) {
      document.documentElement.classList.add("cladone-authed");
      try { buildBadge(); } catch (e) { /* le badge ne casse rien */ }
    } else {
      document.documentElement.classList.remove("cladone-authed");
      if (USERBADGE &&
          (sessionDied || USERBADGE.loginBadge)) {
        // la poignée devient l'invitation à se connecter (mort de
        // session détectée, ou option loginBadge : dès l'anonyme)
        try { buildLoginBadge(); }
        catch (e) { if (badgeEl) { badgeEl.remove(); badgeEl = null; } }
      } else if (badgeEl) {
        badgeEl.parentNode.removeChild(badgeEl);
        badgeEl = null;
      }
    }
    var waiters = stateWaiters.splice(0, stateWaiters.length);
    waiters.forEach(function (r) { r(v); });
  }

  try {
    var cssText =
      "html:not(.cladone-authed) [data-gtw-auth-hidden='before']" +
      "{display:none !important}" +
      "html.cladone-authed [data-gtw-auth-hidden='after']" +
      "{display:none !important}" +
      // éléments à condition d'identité (rôles/scopes/claims) :
      // masqués par défaut (anti-FOUC), révélés après évaluation JS
      "html:not(.cladone-evaluated) [data-gtw-roles]," +
      "html:not(.cladone-evaluated) [data-gtw-scopes]," +
      "html:not(.cladone-evaluated) [data-gtw-claims]" +
      "{display:none !important}" +
      "html:not(.cladone-authed) [data-gtw-auth]{cursor:pointer}" +
      // badge utilisateur, trois états : REplié (poignée 👤+nom,
      // INVISIBLE tant que la souris n'approche pas le bord haut —
      // détection mousemove, pointer-events:none au repos pour ne
      // jamais bloquer les clics de la page) / APERÇU au survol-focus
      // et à la manifestation post-login (max-height partielle :
      // l'identité apparaît) / DÉPLIÉ au clic (tout : claims +
      // déconnexion) — la règle open est déclarée EN DERNIER : à
      // égalité de spécificité, c'est elle qui gagne quand le survol
      // et l'ouverture coexistent
      ".cladone-userbadge{opacity:0;pointer-events:none}" +
      ".cladone-userbadge-near,.cladone-userbadge-reveal" +
      "{opacity:1;pointer-events:auto}" +
      ".cladone-userbadge:focus-within{opacity:1;pointer-events:auto}" +
      ".cladone-userbadge:hover,.cladone-userbadge:focus-within," +
      ".cladone-userbadge-reveal{max-height:4.6em !important}" +
      // l'état ouvert doit battre le :hover (sinon l'aperçu, plus
      // spécifique, écrase le dépliage dès que la souris revient
      // dessus — le bouton devient incliquable) : classe doublée =
      // spécificité supérieure + déclarée après
      ".cladone-userbadge.cladone-userbadge-open" +
      "{max-height:24em !important;opacity:1;pointer-events:auto}";
    // voile anti-FOUC des règles uiGate : une règle CSS PAR
    // sélecteur (un sélecteur invalide ne doit tuer que son propre
    // masquage, pas celui des autres)
    for (var gi = 0; gi < UIGATE.length; gi++) {
      cssText += "html:not(.cladone-evaluated) " +
        UIGATE[gi].selector + "{display:none !important}";
    }
    var css = document.createElement("style");
    css.textContent = cssText;
    (document.head || document.documentElement).appendChild(css);
  } catch (e) { /* never break the page over gating */ }

  // Gating par rôles/scopes/claims : un élément n'est visible que si
  // TOUTES ses conditions d'identité passent (OU au sein d'un
  // attribut, ET entre attributs). Anonyme = aucun rôle/scope/claim
  // → masqué (l'authentification est implicite). Confort UI
  // uniquement : l'interdiction réelle reste côté endpoint
  // (auth.when.roles/scopes/claims) ou backend.
  function applyRoleGating() {
    var nodes = document.querySelectorAll(
      "[data-gtw-roles],[data-gtw-scopes],[data-gtw-claims]"
    );
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      var ok = true;
      var rl = n.getAttribute("data-gtw-roles");
      if (ok && rl) {
        ok = rl.split(/\s+/).filter(Boolean).some(function (r) {
          return sessionRoles.indexOf(r) !== -1;
        });
      }
      if (ok) {
        var sc = n.getAttribute("data-gtw-scopes");
        if (sc) {
          ok = sc.split(/\s+/).filter(Boolean).some(function (s) {
            return sessionScopes.indexOf(s) !== -1;
          });
        }
      }
      if (ok) {
        var cl = n.getAttribute("data-gtw-claims");
        if (cl) {
          try {
            var spec = JSON.parse(cl);
            for (var k in spec) {
              var want = spec[k];
              var have = sessionClaims[k];
              if (want === "*") {
                if (have === undefined) { ok = false; break; }
              } else if (String(have) !== want) {
                ok = false; break;
              }
            }
          } catch (e) { ok = false; }
        }
      }
      if (!ok) {
        n.style.display = "none";
        n.setAttribute("data-gtw-gated-off", "1");
      } else if (n.getAttribute("data-gtw-gated-off")) {
        n.removeAttribute("data-gtw-gated-off");
        n.style.display = "";
      }
    }
    applyRuleGating();
    // l'évaluation est faite : lever le voile anti-FOUC (les
    // masquages inline des non-conformes restent en place)
    document.documentElement.classList.add("cladone-evaluated");
  }

  // Badge utilisateur (config userBadge) : onglet replié au bord
  // supérieur (position left|right), déplié au survol/focus (CSS,
  // max-height transitionné). Contenu : les claims choisis + le
  // bouton de déconnexion (navigation end_session). Absent en
  // anonyme et sans policy. Construit en DOM pur (jamais innerHTML).
  var badgeEl = null;

  function removeBadge() {
    if (badgeEl) {
      badgeEl.parentNode.removeChild(badgeEl);
      badgeEl = null;
    }
  }

  // Socle commun aux deux modes du badge (authentifié / invitation
  // login) : typographie adaptative au site hôte + styles de base.
  function makeBadgeEl() {
    var pos = USERBADGE.position === "left" ? "left" : "right";
    // typographie adaptative : épouser le site hôte — médiane des
    // tailles calculées des éléments de texte (repli : body, puis
    // 13px), bornée 11-15px ; TOUTES les dimensions du badge sont
    // en em et suivent. 13px en dur était trop grand sur un site à
    // typographie fine (livre pré-paginé) et juste sur vers.
    var fs = 13;
    try {
      var sizes = [];
      var sample = document.querySelectorAll(
        "p,li,td,th,blockquote,dd,figcaption"
      );
      for (var si = 0;
           si < sample.length && sizes.length < 50;
           si++) {
        var sfs = parseFloat(
          getComputedStyle(sample[si]).fontSize
        );
        if (isFinite(sfs) && sfs > 0) sizes.push(sfs);
      }
      var siteFs;
      if (sizes.length) {
        sizes.sort(function (a, b) { return a - b; });
        siteFs = sizes[Math.floor(sizes.length / 2)];
      } else {
        siteFs = parseFloat(
          getComputedStyle(document.body).fontSize
        );
      }
      if (isFinite(siteFs) && siteFs > 0) {
        fs = Math.min(Math.max(siteFs * 0.9, 11), 15);
      }
    } catch (e) { /* mesure impossible : défaut 13px */ }
    fs = Math.round(fs * 10) / 10;
    badgeEl = document.createElement("div");
    badgeEl.className = "cladone-userbadge";
    // collé au bord du HAUT, écart latéral de 12 px, angles
    // arrondis en bas seulement (il touche le haut)
    badgeEl.style.cssText =
      "position:fixed;top:0;" + pos + ":12px;z-index:2147483646;" +
      "background:#20242e;color:#fff;padding:.46em .92em;" +
      "font:" + fs + "px/1.4 system-ui,sans-serif;" +
      "text-align:left;" +
      "border-radius:0 0 .62em .62em;max-width:21.5em;" +
      "box-shadow:0 4px 18px rgba(0,0,0,.3);" +
      "max-height:2.3em;overflow:hidden;" +
      "transition:opacity .2s ease,max-height .25s ease;cursor:default";
    var tab = document.createElement("div");
    tab.className = "cladone-userbadge-tab";
    badgeEl.appendChild(tab);
    var body = document.createElement("div");
    body.className = "cladone-userbadge-body";
    body.style.cssText = "padding:.46em 0 .15em 0";
    badgeEl.appendChild(body);
    document.body.appendChild(badgeEl);
  }

  function buildBadge() {
    if (!USERBADGE || !authed || !document.body) return;
    if (badgeEl &&
        badgeEl.getAttribute("data-gtw-mode") === "login") {
      removeBadge(); // le mode a changé : reconstruire authentifié
    }
    if (!badgeEl) {
      makeBadgeEl();
      badgeEl.setAttribute("data-gtw-mode", "authed");
      // manifestation discrète post-login : déplié 2 s puis escamoté
      badgeEl.classList.add("cladone-userbadge-reveal");
      setTimeout(function () {
        if (badgeEl) badgeEl.classList.remove("cladone-userbadge-reveal");
      }, 2000);
    }
    // première ligne (visible même replié) : l'icône + l'identité
    var tab = badgeEl.firstChild;
    tab.textContent = "\uD83D\uDC64 " + String(sessionClaims.preferred_username || "compte");
    var body = badgeEl.lastChild;
    body.textContent = "";
    var claims = USERBADGE.claims || [];
    for (var i = 0; i < claims.length; i++) {
      if (claims[i] === "preferred_username") continue; // déjà en tête
      var v = sessionClaims[claims[i]];
      if (v === undefined) continue; // claim absent : ligne omise
      var row = document.createElement("div");
      row.style.cssText =
        "white-space:nowrap;overflow:hidden;text-overflow:ellipsis";
      row.textContent = claims[i] + " : " + String(v);
      body.appendChild(row);
    }
    var btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = USERBADGE.logoutLabel || "D\u00e9connexion";
    btn.style.cssText =
      "margin-top:.46em;border:0;border-radius:.46em;padding:.38em .77em;" +
      "cursor:pointer;font:inherit;color:#fff;background:#a04040";
    btn.onclick = function () {
      location.href = LOGOUT_URL + "?returnTo=" +
        encodeURIComponent(location.href);
    };
    body.appendChild(btn);
  }

  // Badge mode « invitation login » : après une mort de session, la
  // même poignée reste en place — cliquer dessus rouvre le login
  // (l'affordance persiste même après avoir refermé la bannière).
  // Invisible tant que la souris n'approche pas du bord, comme en
  // mode authentifié.
  function buildLoginBadge() {
    if (!USERBADGE || authed || !document.body) return;
    removeBadge();
    makeBadgeEl();
    badgeEl.setAttribute("data-gtw-mode", "login");
    badgeEl.style.cursor = "pointer";
    badgeEl.title = "Se reconnecter";
    badgeEl.firstChild.textContent =
      "\uD83D\uDC64 " + "Se connecter";
    badgeEl.onclick = function (ev) {
      ev.stopPropagation();
      ensureLogin();
    };
    // manifestation discrète : visible 2 s pour se faire remarquer,
    // puis même discret que le badge authentifié
    badgeEl.classList.add("cladone-userbadge-reveal");
    setTimeout(function () {
      if (badgeEl) badgeEl.classList.remove("cladone-userbadge-reveal");
    }, 2000);
  }

  // Détection de l'approche du bord HAUT : le badge est invisible
  // (opacity 0 + pointer-events none) tant que la souris n'approche
  // pas (clientY <= 40) ; il reste visible tant qu'il est survolé,
  // déplié, ou en manifestation post-login.
  if (USERBADGE) {
    window.addEventListener("mousemove", function (ev) {
      if (!badgeEl) return;
      var near = badgeEl.matches(":hover") ||
        badgeEl.classList.contains("cladone-userbadge-open") ||
        badgeEl.classList.contains("cladone-userbadge-reveal");
      if (!near && ev.clientY <= 40) {
        // proximité de LA ZONE du badge (pas tout le bord haut) :
        // bande verticale du haut + rayon horizontal autour de la
        // poignée (le badge ne réagit qu'à l'approche de SON coin)
        var r = badgeEl.getBoundingClientRect();
        var margin = 150;
        near = ev.clientX >= r.left - margin &&
               ev.clientX <= r.right + margin;
      }
      badgeEl.classList.toggle("cladone-userbadge-near", near);
    });
  }

  // Gating par règles uiGate (config) : mêmes mécanismes que les
  // attributs markup, mais les éléments sont désignés par sélecteur
  // CSS. Un élément portant un attribut data-gtw-* est IGNORÉ par
  // les règles (précédence : le markup gagne). Plusieurs règles sur
  // un même élément se cumulent en ET. Sélecteur invalide = règle
  // ignorée, jamais d'erreur visible.
  function rulePasses(rule) {
    var ok = true;
    if (ok && rule.roles && rule.roles.length) {
      ok = rule.roles.some(function (r) {
        return sessionRoles.indexOf(r) !== -1;
      });
    }
    if (ok && rule.scopes && rule.scopes.length) {
      ok = rule.scopes.some(function (s) {
        return sessionScopes.indexOf(s) !== -1;
      });
    }
    if (ok && rule.claims) {
      for (var k in rule.claims) {
        var want = rule.claims[k];
        var have = sessionClaims[k];
        if (want === "*") {
          if (have === undefined) { ok = false; break; }
        } else if (String(have) !== want) {
          ok = false; break;
        }
      }
    }
    return ok;
  }

  function applyRuleGating() {
    for (var i = 0; i < UIGATE.length; i++) {
      var rule = UIGATE[i];
      if (!rule || !rule.selector) continue;
      var nodes;
      try {
        nodes = document.querySelectorAll(rule.selector);
      } catch (e) {
        continue; // sélecteur invalide : règle ignorée
      }
      if (nodes.length === 0) {
        // la règle est bien servie par la gateway mais ne matche
        // AUCUN élément de cette page : probable coquille dans le
        // sélecteur (#id vs .class…) — signalée pour débogage,
        // sans effet de bord (fail-open assumé)
        console.warn(
          "uiGate: regle sans element (selector):", rule.selector
        );
        continue;
      }
      for (var j = 0; j < nodes.length; j++) {
        var n = nodes[j];
        if (n.hasAttribute("data-gtw-auth") ||
            n.hasAttribute("data-gtw-auth-hidden") ||
            n.hasAttribute("data-gtw-roles") ||
            n.hasAttribute("data-gtw-scopes") ||
            n.hasAttribute("data-gtw-claims")) {
          continue; // précédence : le markup gagne
        }
        var ok = rulePasses(rule);
        if (!ok) {
          n.style.display = "none";
          n.setAttribute("data-gtw-gated-off", "1");
        } else if (n.getAttribute("data-gtw-gated-off")) {
          n.removeAttribute("data-gtw-gated-off");
          n.style.display = "";
        }
      }
    }
  }

  function fetchSession() {
    orig(AUTH_STATE, { cache: "no-store" }).then(function (res) {
      if (res.status === 401) {
        // 401 = la vérité du moment (le serveur vient de vérifier) :
        // la session a expiré ou a été révoquée pendant la lecture.
        sessionRoles = [];
        sessionScopes = [];
        sessionClaims = {};
        applyRoleGating();
        settleState(false, true);
        if (sessionDied) showBanner(); // invitation à se reconnecter
        return;
      }
      if (res.status !== 200) {
        // 5xx/429… : transitoire — l'état affiché ne bouge pas.
        settleState(false);
        return;
      }
      res.json().then(function (s) {
        sessionRoles = s.roles || [];
        sessionScopes = s.scopes || [];
        sessionClaims = s.claims || {};
        applyRoleGating();
        settleState(true);
      }).catch(function () {
        applyRoleGating();
        settleState(false);
      });
    }).catch(function () {
      // réseau/SW en erreur : fail-closed — pas de révélation des
      // éléments à condition d'identité
      settleState(false);
    });
  }

  function probeSession() {
    // data-gtw-logout et userBadge exigent AUSSI la sonde : le logout
    // ne s'applique qu'authentifié, et le badge a besoin des claims.
    if (!document.querySelector(
      "[data-gtw-auth],[data-gtw-auth-hidden],[data-gtw-logout]," +
      "[data-gtw-roles],[data-gtw-scopes],[data-gtw-claims]"
    ) && !UIGATE.length && !USERBADGE) {
      return; // no gating declared: no probe, fully transparent
    }
    fetchSession();
  }

  // Session probe (Bearer header or cookie session), gateway-served,
  // never cached by the PWA service worker ("auth" exclude pattern).
  // AUTH_STATE is injected from AuthStatePath (guard.go). Runs at
  // DOMContentLoaded so pages without any gated element make no
  // request at all.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", probeSession);
  } else {
    probeSession();
  }

  // Re-sonde périodique + au retour sur l'onglet : la session peut
  // mourir EN COURS DE LECTURE (idle SSO, révocation) — le badge et
  // le gating reflètent l'état réel, pas un état périmé. BONUS : la
  // sonde entretient la session (silent refresh sur /auth) — lire
  // longtemps sans charger d'images ne la laisse plus expirer.
  setInterval(probeSession, 60000);
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden) probeSession();
  });

  // Click handling while anonymous (capture phase). Two attributes,
  // two orthogonal dimensions:
  //
  //   data-gtw-auth — WHEN auth happens:
  //     "after"  : native click preserved (no preventDefault) — the
  //                auth is enforced at the request level (401 queued,
  //                replayed after login) ; the tab opens on click as
  //                an invitation ;
  //     "before" : the click is neutralized (no native request) and
  //                the login tab opens directly — authenticate
  //                first, act after.
  //
  //   data-gtw-auth-hidden — visibility:
  //     "before" : hidden while anonymous — activating clicks
  //                (direct, synthetic label activation) are
  //                neutralized: never a silent pre-tick, the banner
  //                offers "Se connecter" ;
  //     "after"  : no click interception (pure affordance hiding,
  //                composable with gtw-auth="before" for padlocks).
  document.addEventListener("click", function (ev) {
    var t = ev.target;
    if (!t || !t.closest) return;

    // badge (authentifié) : clic dedans → dépliage complet (bascule) ;
    // clic dehors → repli. Le bouton de déconnexion n'alterne pas :
    // il navigue (son propre onclick).
    if (authed && badgeEl) {
      if (badgeEl.contains(t)) {
        if (!t.closest("button")) {
          badgeEl.classList.toggle("cladone-userbadge-open");
        }
        return;
      }
      badgeEl.classList.remove("cladone-userbadge-open");
    }

    // Déconnexion (data-gtw-logout) : look entièrement à l'app, le
    // garde ne câble que le clic. Seulement AUTHENTIFIÉ — ignoré silencieusement
    // en anonyme (rien à déconnecter). La NAVIGATION est inhérente :
    // end_session OIDC est un redirect ; retour sur cette page,
    // désormais anonyme (gating ré-appliqué).
    if (authed && t.closest("[data-gtw-logout]")) {
      location.href = LOGOUT_URL + "?returnTo=" +
        encodeURIComponent(location.href);
      return;
    }

    if (authed) return; // authentifié : clics natifs (passthrough)
    var before = t.closest('[data-gtw-auth="before"]');
    if (before) {
      ev.preventDefault();
      ev.stopPropagation();
      window.__cladoneAuth.login();
      return;
    }
    var after = t.closest('[data-gtw-auth="after"]');
    if (after) {
      // l'action native procede (cocher la case…) ; la requete 401
      // qui en resulte est mise en file puis rejouee apres login
      window.__cladoneAuth.login();
      return;
    }
    var hiddenPre = t.closest('[data-gtw-auth-hidden="before"]');
    if (hiddenPre) {
      ev.preventDefault();
      ev.stopPropagation();
      showBanner(ev);
      return;
    }

    // règles uiGate (config) : auth et masquage pré-auth — mêmes
    // sémantiques que les attributs markup ; un élément markup a
    // déjà court-circuité ci-dessus (précédence)
    for (var gi = 0; gi < UIGATE.length; gi++) {
      var rule = UIGATE[gi];
      if (!rule || !rule.selector) continue;
      var hit = null;
      try {
        hit = t.closest(rule.selector);
      } catch (e) {
        continue; // sélecteur invalide : règle ignorée (comme dans
                  // applyRuleGating) — jamais d'exception visible
      }
      if (!hit) continue;
      if (rule.hidden === "before") {
        // contrôle masqué en anonyme : tout clic qui l'atteint est
        // synthétique (activation label) — jamais de pré-cochage
        ev.preventDefault();
        ev.stopPropagation();
        showBanner(ev);
        return;
      }
      if (rule.auth) {
        if (rule.auth === "before") {
          ev.preventDefault();
          ev.stopPropagation();
        }
        // "after" : l'action native procède, la 401 sera rejouée
        window.__cladoneAuth.login();
        return;
      }
    }

    var lbl = t.closest("label");
    if (lbl && lbl.querySelector('[data-gtw-auth-hidden="before"]')) {
      ev.preventDefault();
      ev.stopPropagation();
      showBanner(ev);
    }
  }, true);

  // La bannière se referme sans action d'authentification : clic
  // n'importe où en dehors d'elle, ou Échap — et l'onglet de login
  // lié se ferme avec elle (cf. dismiss). Enregistrés APRÈS le
  // handler d'affordance ci-dessus : un clic sur un élément de
  // login (ou sur un bouton de la bannière) gagne toujours.
  document.addEventListener("click", function (ev) {
    if (!banner) return;
    if (banner.contains(ev.target)) return;
    if (shownBy === ev) return; // le clic qui a affiché la bannière
    dismiss();
  }, true);

  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape" && banner) dismiss();
  }, true);

  // Opt-in API for apps willing to trigger the same no-reload login
  // from their own UI, or to know the session state. login() opens
  // the tab directly (explicit user intent) and resolves true once
  // the gateway session is active, false if abandoned (×). state()
  // resolves to the current session state (probe result).
  window.__cladoneAuth = {
    login: function () {
      return new Promise(function (resolve, reject) {
        queue.push({ barrier: true, resolve: resolve, reject: reject });
        ensureLogin();
      });
    },
    state: function () {
      return new Promise(function (resolve) {
        if (probeDone) { resolve(authed); return; }
        stateWaiters.push(resolve);
      });
    },
    // Session détaillée (opt-in) : {roles, scopes, claims} une fois
    // la sonde passée (ou null si anonyme). Pour les applications qui
    // veulent filtrer en JS sans relire un token.
    session: function () {
      return new Promise(function (resolve) {
        var snap = function (ok) {
          resolve(ok ? {
            roles: sessionRoles.slice(),
            scopes: sessionScopes.slice(),
            claims: sessionClaims
          } : null);
        };
        if (probeDone) { snap(authed); return; }
        stateWaiters.push(snap);
      });
    }
  };

  window.fetch = function (input, init) {

    // Clone BEFORE the call: a Request body can be read only once,
    // the copy is kept for the post-login replay.
    var replay = buildReplay(input, init);

    return orig.apply(this, arguments).then(function (res) {

      // 401 SEULEMENT : c'est le signal « authentifie-toi ». Un 403
      // (authentifié mais droits insuffisants — when.roles/scopes/
      // claims) traverse vers l'application : offrir un login sur un
      // refus de droits produirait une boucle.
      if (!res || res.status !== 401 || res.url.startsWith(LOGIN)) {
        return res;
      }

      if (!replay || LOGIN_ORIGIN === "") {
        // Cannot replay: historical fallback, full-page redirect
        // (the app reloads and re-issues the request itself).
        setTimeout(fullRedirect, 0);
        return new Promise(function () {}); // navigation takes over
      }

      return new Promise(function (resolve, reject) {
        // 401 en flux (clic hors affordance de login) : bannière
        // ONLY — jamais d'onglet en ouverture automatique, un 401
        // de fond ne doit pas voler le focus. L'onglet ne s'ouvre
        // que sur un clic explicite (cadenas, bouton de la
        // bannière). Bannière refermable (×) : les requêtes
        // repartent avec leur 401 d'origine, l'app continue.
        queue.push({ req: replay, res401: res, resolve: resolve, reject: reject });
        // un onglet de login deja ouvert EST l'invitation : pas de
        // banniere redondante a cote
        if (!(loginTab && !loginTab.closed)) showBanner();
      });
    });
  };
})();
</script>
